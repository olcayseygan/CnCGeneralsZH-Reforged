TOOLTIP:StatTime
"Build time"
END

TOOLTIP:StatSeconds
"%ds"
END

TOOLTIP:StatDamage
"Damage"
END

TOOLTIP:StatRange
"Range"
END

TOOLTIP:StatHealth
"Health"
END

TOOLTIP:StatAttackSpeed
"Attack speed"
