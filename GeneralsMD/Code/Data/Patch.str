TOOLTIP:StatSeconds
"%ds"
END

TOOLTIP:StatDamage
"Damage"
END

TOOLTIP:StatRange
"Range"
END

TOOLTIP:StatHealth
"Health"
END

TOOLTIP:StatAttackSpeed
"Attack speed"
END

TOOLTIP:StatPerSecond
"/s"
END

TOOLTIP:StatDamagePerSecond
"Damage per second"
END

TOOLTIP:StatArmor
"Armor"
END

TOOLTIP:StatArmorStronger
"stronger, less of each hit gets through"
END

TOOLTIP:StatNewWeapon
"New weapon"
END

TOOLTIP:StatNewWeaponGround
"Ground weapon"
END

TOOLTIP:StatNewWeaponAir
"Anti-air weapon"
END

TOOLTIP:StatNewWeaponFigures
"%d damage, %d range"
END

// The card's armour cell: the class of the unconditioned ArmorSet's armour, TOOLTIP:Armor and the
// Armor block's name with its first "Armor" taken out.  Short, a cell is about sixty pixels wide.

TOOLTIP:ArmorNo
"None"
END

