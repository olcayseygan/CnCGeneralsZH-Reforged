END

TOOLTIP:StatArmor
"Blindage"
END

TOOLTIP:StatArmorStronger
"plus résistant"
END

TOOLTIP:StatNewWeapon
"Nouvelle arme"
END

TOOLTIP:StatNewWeaponGround
"Arme sol"
END

TOOLTIP:StatNewWeaponAir
"Arme antiaérienne"
END

