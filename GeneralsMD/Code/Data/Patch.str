// ---------------------------------------------------------------------------
// Options screen.  The five page buttons across the top.
// ---------------------------------------------------------------------------

GUI:OptionsTabDisplay
"Display"
END

GUI:OptionsTabAudio
"Audio"
END

GUI:OptionsTabControls
"Controls"
END

GUI:OptionsTabGameplay
"Gameplay"
END

GUI:OptionsTabNetwork
"Network"
END

GUI:OptionsTabGraphics
"Graphics"
END

GUI:OptionsTabEffects
"Effects"
END

GUI:Ultra
"Ultra"
END

GUI:TreeSway
"Swaying Trees"
END

TOOLTIP:TreeSway
"Trees and shrubs lean in the wind. Applies from the next map."
END

TOOLTIP:ExtraAnimations
"Buildings rise inside scaffolding while they are built. Applies from the next map."
END

GUI:ExtraAnimations
"Building Scaffolding"
END

GUI:Detail
"Detail Preset"
END

GUI:DetailNote0
"Every box on, the most particles and thick smoke, and detail never drops in a big fight. Picking it only fills in the boxes; Accept applies it."
END

GUI:DetailNote1
"All the shadows and full-size textures, with the original smoke. Picking it only fills in the boxes; Accept applies it."
END

GUI:DetailNote2
"Flat shadows in place of cast ones and fewer particles, for a modest graphics card. Picking it only fills in the boxes; Accept applies it."
END

GUI:DetailNote3
"No shadows, half-size textures and the fewest particles, for an old machine. Picking it only fills in the boxes; Accept applies it."
END

GUI:DetailNote4
"Your own mix of the boxes on this page and on Effects. Accept keeps it as it is."
END

GUI:Shadows3D
"Cast Shadows"
END

TOOLTIP:Shadows3D
"Shadows that units, buildings and trees throw on the ground and on each other. Off turns all of them off, the sun's shadows included, and Infantry Shadows needs it on. Applies when you press Accept; a few shadows only change on the next map."
END

GUI:Shadows2D
"Flat Shadows"
END

TOOLTIP:Shadows2D
"The flat dark patch drawn under a unit or a missile that has no cast shadow. Costs little. Applies when you press Accept."
END

TOOLTIP:CloudShadows
"Cloud shadows drift across the ground. Costs little. Applies when you press Accept."
END

GUI:GroundLighting
"Ground Pattern"
END

TOOLTIP:GroundLighting
"A faint pattern of light and dark laid over the ground, so its repeating tiles show less. Costs little. Applies when you press Accept."
END

GUI:SmoothWater
"Soft Shorelines"
END

TOOLTIP:SmoothWater
"Water fades out at the shore instead of ending on a hard line. Applies from the next map."
END

GUI:ShowProps
"Trees And Bushes"
END

TOOLTIP:ShowProps
"Trees and bushes on the map. Off helps a slow machine. Network games always show them. Applies from the next map."
END

GUI:HeatEffects
"Heat Haze"
END

TOOLTIP:HeatEffects
"Hot air shimmers, as it does over the Microwave Tank's beam. Applies when you press Accept."
END

GUI:BehindBuilding
"Units Behind Buildings"
END

TOOLTIP:BehindBuilding
"A unit hidden behind a building shows through it as a silhouette in its player's colour. Applies when you press Accept."
END

TOOLTIP:NoDynamicLOD
"When the frame rate drops in a big fight, the game thins out effects to keep up. On, it never does: the picture stays full and the frame rate takes the hit."
END

TOOLTIP:LowResSlider
"How sharp the textures are. Lower saves graphics memory on an old card. Applies when you press Accept."
END

TOOLTIP:ParticleCapSlider
"How many particles of smoke, fire and sparks can exist at once. Big fights reach the limit first; lower it if explosions slow the game down. Applies when you press Accept."
END

GUI:TextureFilter
"Texture Filtering"
END

GUI:TextureFilter0
"Bilinear"
END

GUI:TextureFilter1
"Trilinear"
END

GUI:TextureFilter2
"Anisotropic"
END

TOOLTIP:TextureFilter
"How textures are sampled as they recede from the camera. Bilinear is what the game shipped with and makes distant ground shimmer; anisotropic keeps it sharp. Applies the next time the game starts."
END

GUI:Anisotropy
"Anisotropic Samples"
END

TOOLTIP:Anisotropy
"How many samples anisotropic filtering may take. Auto lets the graphics card decide, up to 16. Only used when texture filtering is anisotropic. Applies the next time the game starts."
END

GUI:AnisotropyCardMaximum
"Auto"
END

GUI:TextureResolution
"Texture Resolution"
END

GUI:ParticleLimit
"Particle Limit"
END

GUI:NeverLowerDetail
"Never Lower Detail"
END

GUI:OptionsGroupScreen
"Screen"
END

GUI:OptionsGroupPicture
"Picture"
END

GUI:OptionsGroupDetail
"Quality"
END

GUI:OptionsGroupEffects
"Effects"
END

GUI:OptionsGroupImage
"Image"
END

GUI:OptionsGroupVolume
"Volume"
END

GUI:OptionsGroupScrolling
"Scrolling"
END

GUI:OptionsGroupOrders
"Orders"
END

GUI:OptionsGroupBattlefield
"Battlefield"
END

GUI:OptionsGroupAddresses
"Addresses"
END

GUI:OptionsGroupFirewall
"Firewall"
END

GUI:OptionsGroupProxy
"Proxy"
END

GUI:OptionsGroupTerrain
"Terrain"
END

GUI:OptionsGroupShadows
"Shadows"
END

GUI:OptionsGroupExtras
"Extras"
END

GUI:OptionsGroupParticles
"Smoke And Particles"
END

// ---------------------------------------------------------------------------
// One GUI: label and one TOOLTIP: line per row of TheOptionCatalog.  A label
// and the combo box under it share the tooltip; an OPTION_ENUM row also needs
// its entries, numbered from zero in the order the enum declares them.
// ---------------------------------------------------------------------------

GUI:WindowMode
"Window Mode"
END

GUI:WindowMode0
"Fullscreen"
END

GUI:WindowMode1
"Borderless"
END

GUI:WindowMode2
"Windowed"
END

TOOLTIP:WindowMode
"Fullscreen takes the display mode, borderless covers it with a window and alt-tabs instantly. Borderless takes the monitor's own resolution, so the list above is yours in the other two."
END

GUI:Monitor
"Monitor"
END

TOOLTIP:Monitor
"The monitor the game plays on. The resolution list below holds the sizes this monitor can show. Applied when you Accept."
END

GUI:MSAA
"Antialiasing"
END

GUI:MSAA0
"Off"
END

GUI:MSAA1
"2x"
END

GUI:MSAA2
"4x"
END

GUI:MSAA3
"8x"
END

GUI:MSAA4
"16x"
END

TOOLTIP:MSAA
"Smooths the stair steps along model edges. Only the Direct3D 9 renderer uses it: the default renderer smooths edges on its own and ignores this setting. A level your card does not offer drops to the highest one it does. Applies the next time the game starts."
END

GUI:Bloom
"Glow"
END

GUI:Bloom0
"Off"
END

GUI:Bloom1
"Subtle"
END

GUI:Bloom2
"Normal"
END

GUI:Bloom3
"Strong"
END

TOOLTIP:Bloom
"How far bright surfaces bleed light into what is around them. Retail had none of this, so Off is what the artwork was painted for."
END

GUI:BloomThreshold
"What Glows"
END

GUI:BloomThreshold0
"Only the brightest"
END

GUI:BloomThreshold1
"Bright things"
END

GUI:BloomThreshold2
"Most of the picture"
END

TOOLTIP:BloomThreshold
"How much of the screen is bright enough to glow at all. Only the brightest keeps it to muzzle flashes and lamps; most of the picture puts a haze over the whole battlefield."
END

GUI:VSync
"Vertical Sync"
END

TOOLTIP:VSync
"Holds the picture to the monitor so it does not tear. Off, the picture runs as fast as the machine draws. Applied when you Accept."
END

GUI:ClassicGraphics
"Classic Graphics"
END

TOOLTIP:ClassicGraphics
"The game as it looked in 2003: its own textures and ground, the old hard shadows, no bump detail and no glow or sharpening. Off is Reforged. Takes effect the next time the game starts."
END

GUI:InfantryShadows
"Infantry Shadows"
END

TOOLTIP:InfantryShadows
"Soldiers and the other animated models cast real shadows too. Needs Cast Shadows. Applies from the next map."
END

GUI:ProjectileShadows
"Missile Shadows"
END

TOOLTIP:ProjectileShadows
"Missiles and bombs the artists gave no shadow get one on the ground. Applies from the next map."
END

GUI:PropShadows
"Scenery Shadows"
END

TOOLTIP:PropShadows
"Fences, rubbish and shrubs, which the original drew with no shadow at all, get one. Applies from the next map."
END

GUI:ParticleShadows
"Smoke Shadows"
END

TOOLTIP:ParticleShadows
"Big clouds of smoke and dust lay a soft shadow on the ground under them. Applies when you press Accept."
END

GUI:Smoke
"Smoke"
END

GUI:Smoke0
"Original"
END

GUI:Smoke1
"Thick"
END

GUI:Smoke2
"Very Thick"
END

TOOLTIP:Smoke
"How long smoke hangs in the air and how dense it looks. 175 of the game's 1088 effects are smoke. Very Thick cost 0.7 ms a frame over a burning column when it was measured. Takes effect the next time the game starts."
END

GUI:ParticleBounce
"Particles Hit The Ground"
END

TOOLTIP:ParticleBounce
"Sparks, debris and the other particles land and bounce on the terrain instead of falling through it. Takes effect the next time the game starts."
END

GUI:MiddleMousePans
"Middle Mouse Pans"
END

TOOLTIP:MiddleMousePans
"Hold the middle button to drag the map under the cursor."
END

GUI:ZoomToCursor
"Zoom To Cursor"
END

TOOLTIP:ZoomToCursor
"The wheel zooms towards whatever the cursor is over instead of the middle of the screen. Modern controls only."
END

GUI:StartAtMaxZoom
"Start Zoomed Out"
END

TOOLTIP:StartAtMaxZoom
"A match opens with the camera as far out as the wheel goes. Off, it opens at the height the map was framed for."
END

GUI:CloserZoom
"Closer Zoom"
END

TOOLTIP:CloserZoom
"How much nearer the ground the wheel may bring the camera. 0% is the game's own limit."
END

GUI:DragTolerance
"Drag Threshold"
END

TOOLTIP:DragTolerance
"How many pixels the mouse may move with a button held before a click becomes a drag. Raise it if selection boxes start by accident, lower it if drags read as clicks."
END

GUI:IsometricCamera
"Isometric Camera"
END

TOOLTIP:IsometricCamera
"The battlefield seen from far off, so a unit is the same size at the top of the screen as at the bottom. You still turn and zoom the camera."
END

GUI:SmoothMotion
"Smooth Motion"
END

TOOLTIP:SmoothMotion
"Units are drawn between the game's 30 steps a second, so they move smoothly on a fast display. The picture is one step (33 ms) behind; the game itself is unchanged."
END

GUI:EdgeScrollWindowed
"Edge Scroll In A Window"
END

TOOLTIP:EdgeScrollWindowed
"Retail refuses to scroll from the screen edge in windowed mode. Turn this on to get it back on a second monitor or in borderless."
END

GUI:SnapCamera45
"Snap Camera Rotation"
END

TOOLTIP:SnapCamera45
"Rotating the camera clicks to the eight 45 degree headings instead of stopping anywhere."
END

GUI:GridBuild
"Grid Building Placement"
END

TOOLTIP:GridBuild
"Structures land on the pathfinder's own 10-unit grid, so two buildings put down by eye share an edge instead of leaving a gap too narrow to walk through."
END

GUI:NudgeBuild
"Nudge Blocked Placement"
END

TOOLTIP:NudgeBuild
"A structure whose spot is blocked slides to the nearest one it fits instead of going red under the cursor."
END

GUI:SnapBuild45
"Snap Building Rotation"
END

TOOLTIP:SnapBuild45
"Drag-to-rotate clicks to the eight 45 degree headings, which is what walls and defenses along a base edge want."
END

GUI:RangeRing
"Placement Range Ring"
END

TOOLTIP:RangeRing
"Draws the weapon range of the structure you are about to place."
END

GUI:WorkersReturn
"Workers Return To Supply"
END

TOOLTIP:WorkersReturn
"A worker that finishes a building goes back to gathering instead of standing where it built."
END

GUI:BuildTooltips
"Detailed Build Tooltips"
END

TOOLTIP:BuildTooltips
"Build buttons list cost, build time and prerequisites."
END

GUI:HudOverlay
"HUD Overlay"
END

TOOLTIP:HudOverlay
"The extra readouts across the top of the screen: power, income and the production strip."
END

GUI:NetBox
"Clock And Frame Rate Box"
END

TOOLTIP:NetBox
"The box in the top right corner with the match clock, the frame rates and the connection. Off, the superweapon timers move up into the corner."
END

GUI:OptionsGroupHud
"HUD"
END

GUI:IncomeRate
"Income Shown"
END

GUI:IncomeRate0
"Per Second"
END

GUI:IncomeRate1
"Per Minute"
END

GUI:IncomeRate2
"Automatic"
END

TOOLTIP:IncomeRate
"What the income beside your money is counted over. Automatic shows it per minute while you earn less than $10 a second, where a whole number per second hides most of the change, and per second above that."
END

GUI:EmptyBuildingPips
"Empty Building Slots"
END

TOOLTIP:EmptyBuildingPips
"The row of empty slots over a building with nobody inside, like the ten over a Barracks. Off, a building shows its slots only while someone is in it."
END

GUI:ArchiveReplays
"Archive Replays"
END

TOOLTIP:ArchiveReplays
"Every game is kept under its own name instead of overwriting the last one."
END

GUI:HealthBars
"Health Bars"
END

GUI:HealthBars0
"Always"
END

GUI:HealthBars1
"Smart"
END

GUI:HealthBars2
"Selection Only"
END

GUI:HealthBars3
"Never"
END

TOOLTIP:HealthBars
"Smart shows a bar over anything hurt, plus the selection and whatever is under the cursor. Selection only is what retail did."
END

GUI:HudScale
"HUD Size"
END

GUI:HudScale0
"100%"
END

GUI:HudScale1
"115%"
END

GUI:HudScale2
"130%"
END

GUI:HudScale3
"150%"
END

TOOLTIP:HudScale
"Draws the command bar and the rest of the bottom HUD larger than your resolution would."
END

GUI:MenuLayout
"Menu Layout"
END

GUI:MenuLayout0
"Stretch"
END

GUI:MenuLayout1
"Fit"
END

TOOLTIP:MenuLayout
"Fit keeps the menus in the shape they were drawn in and centres them on a wide screen. Stretch widens them to the screen's edges, as the game always did."
END

GUI:OptionsGroupInput
"Input"
END

GUI:ChromaLighting
"Razer Chroma Lighting"
END

TOOLTIP:ChromaLighting
"During a match, a Razer keyboard, mouse and mousepad show the command bar, power, superweapons and money. In the menus Synapse keeps its own lighting."
END

GUI:OrderLines
"Order Lines"
END

TOOLTIP:OrderLines
"A line from each selected unit to where it is going, and on through every point it has queued. Off, the markers on those points stay."
END

GUI:PlayerColors
"Player Colors"
END

GUI:PlayerColors0
"Original"
END

GUI:PlayerColors1
"You, Allies, Enemies"
END

GUI:PlayerColors2
"By Team"
END

TOOLTIP:PlayerColors
"You, allies, enemies paints you blue, everyone on your side green and everyone shooting at you red. By team gives each alliance its own color and each member of it a shade. Your own screen only, so it changes nothing for anyone else in the game."
END

// Language - the Gameplay page's second group.  Each entry is written in its own language, so a
// player who cannot read the current one can still find theirs.

GUI:OptionsGroupLanguage
"Language"
END

GUI:Language
"Text Language"
END

GUI:Language0
"English"
END

GUI:Language1
"Türkçe"
END

GUI:Language2
"Deutsch"
END

TOOLTIP:Language
"The language of menus, orders, briefings and subtitles. Voices and videos stay as installed. Takes effect the next time the game starts."
END

// Hovering a supply pile: EA's TOOLTIP:SupplyWarehouse line with the share of the pile's starting
// cash that is left.  The cash first, then the percentage.

TOOLTIP:SupplyWarehousePercent
"\n $%d remain (%d%%)"
END

// The line under it when the lobby's Pile Limit has the pile closed to the player looking at it.

TOOLTIP:SupplyPileFull
"\n Taken: the pile limit keeps your gatherers out"
END

// The numbers the build tooltip adds under a unit's description: its build time, then its best
// weapon's damage and range.  ControlBarPopupDescription.cpp puts the gap between the two.

TOOLTIP:BuildTimeSeconds
"\nTime %ds"
END

TOOLTIP:WeaponStats
"Dmg %d  Range %d"
END

